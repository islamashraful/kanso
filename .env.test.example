# Copy to .env.test before running the test suite.
#
# Bun loads this file automatically when NODE_ENV=test, which `bun test` sets.
# Without it, tests fall back to .env and wipe the development database:
# every test case clears the tables before it runs.
DATABASE_URL=postgresql://kanso:kanso@localhost:5432/kanso_test

JWT_SECRET=any-32-character-string-works-for-tests-here
