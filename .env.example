NODE_ENV=development
PORT=3000

# Postgres runs in Docker Compose. Run `docker compose up -d` first.
DATABASE_URL=postgresql://kanso:kanso@localhost:5432/kanso

# Tests use a separate database. Copy .env.test.example to .env.test as well,
# or the suite will wipe this one.

# Redis runs in Docker Compose too.
REDIS_URL=redis://localhost:6379

# Signing key for access tokens. Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-openssl-rand-hex-32-output

# Token lifetimes. Both are optional; the defaults below are what the config
# applies when they are unset.
#
# An access token cannot be revoked once issued, so its lifetime is the only
# limit on a stolen one — keep it short. A refresh token is stored and can be
# revoked, which is what makes a long lifetime safe. See docs/adr/0011.
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=30

# MinIO runs in Docker Compose too, standing in for S3 (docker-compose.yml's
# minio-init service creates this bucket on startup). Real S3 in production
# needs only S3_BUCKET/S3_REGION and real IAM credentials — leave
# S3_ENDPOINT and S3_FORCE_PATH_STYLE unset there.
S3_BUCKET=kanso-dev
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
# MinIO needs the bucket name in the URL path (localhost:9000/bucket/file),
# not as a subdomain like real S3 (bucket.s3.amazonaws.com/file). Off in
# production, where real S3 is used.
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=kanso
S3_SECRET_ACCESS_KEY=kanso-minio
