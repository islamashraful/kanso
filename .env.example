NODE_ENV=development
PORT=3000

# Postgres runs in Docker Compose. Run `docker compose up -d` first.
DATABASE_URL=postgresql://kanso:kanso@localhost:5432/kanso

# Tests use a separate database. Copy .env.test.example to .env.test as well,
# or the suite will wipe this one.

# Signing key for access tokens. Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-openssl-rand-hex-32-output

# Token lifetimes. Both are optional; the defaults below are what the config
# applies when they are unset.
#
# An access token cannot be revoked once issued, so its lifetime is the only
# limit on a stolen one — keep it short. A refresh token is stored and can be
# revoked, which is what makes a long lifetime safe. See docs/adr/0011.
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=30
