{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Unused locals and parameters are reported by ESLint instead, which
    // supports an ignore pattern for the deliberately-unused `next` in
    // Express error middleware.
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    // Declared explicitly rather than relying on automatic @types discovery,
    // which some editors resolve differently to tsc. bun-types re-exports the
    // Node globals (`process`, `Buffer`), so no separate @types/node entry.
    "types": ["bun"],

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // The seed and the Prisma config are TypeScript that Bun runs like any
  // other, so they are typechecked like any other. Leaving them out meant a
  // broken seed script was only discoverable by running it.
  "include": ["src/**/*.ts", "prisma/**/*.ts", "prisma.config.ts"]
}
