{
  "name": "kanso",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "worker": "bun --watch src/worker.ts",
    "worker:start": "bun src/worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "db:generate": "bunx --bun prisma generate",
    "db:migrate": "bunx --bun prisma migrate dev",
    "db:seed": "bunx --bun prisma db seed",
    "db:migrate:test": "DATABASE_URL=postgresql://kanso:kanso@localhost:5432/kanso_test bunx --bun prisma migrate deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "typescript-eslint": "^8.66.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-presigned-post": "^3.1121.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@scalar/express-api-reference": "^0.10.13",
    "bullmq": "^6.2.0",
    "express": "5",
    "ioredis": "^6.0.0",
    "jose": "^6.2.8",
    "zod": "^4.4.3",
    "zod-openapi": "^6.0.0"
  },
  "main": "src/server.ts"
}
