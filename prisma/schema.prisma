// Datasource URL is configured in prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "bun"
}

datasource db {
  provider = "postgresql"
}

/// A person. Users exist independently of organizations and reach data only
/// through a Membership.
model User {
  id           String   @id @default(uuid(7))
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   Membership[]
  refreshTokens RefreshToken[]
  attachments   Attachment[]

  @@map("users")
}

/// One issued refresh token. Only the hash is stored: the database is the most
/// likely place a token leaks from, and a hash there cannot be replayed. Rows
/// are kept after use rather than deleted, so a rotated token presented a
/// second time is recognisable as reuse rather than merely unknown.
/// See docs/adr/0011.
model RefreshToken {
  id        String    @id @default(uuid(7))
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// A tenant. Every domain record below this belongs to exactly one
/// organization, and every query is scoped by it. See docs/adr/0007.
model Organization {
  id        String   @id @default(uuid(7))
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  projects    Project[]
  tasks       Task[]
  attachments Attachment[]

  @@map("organizations")
}

/// A container for tasks, owned by exactly one organization. The unique on
/// (id, organizationId) is redundant on its own — id is already unique — and
/// exists so Task can reference the pair rather than the id alone. See
/// docs/adr/0010.
model Project {
  id             String   @id @default(uuid(7))
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("projects")
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

/// A unit of work, owned by exactly one organization and belonging to one
/// project. The organizationId is stored on the task rather than reached
/// through the project, so every query filters on it directly; the composite
/// foreign key below is what stops the two from disagreeing. See docs/adr/0010.
///
/// The unique on (id, organizationId) exists for the same reason as
/// Project's: Attachment references the pair rather than the id alone. See
/// docs/adr/0018.
model Task {
  id             String     @id @default(uuid(7))
  organizationId String
  projectId      String
  title          String
  status         TaskStatus @default(OPEN)
  assigneeId     String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  // Same composite-FK trick as `project` above: referencing Membership's own
  // (userId, organizationId) unique makes "the assignee is a member of this
  // task's organization" a database guarantee, not just an application
  // check. See docs/adr/0010 and docs/adr/0016.
  //
  // Restrict, not SetNull: organizationId is required on this side of the
  // composite key, so SetNull would try to null it out too and fail. There
  // is no membership-removal endpoint yet to make this reachable; when one
  // exists it must clear assigneeId itself before removing a membership.
  assignee     Membership?  @relation(fields: [assigneeId, organizationId], references: [userId, organizationId], onDelete: Restrict)
  attachments  Attachment[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([projectId, organizationId])
  @@map("tasks")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

/// Join table carrying the user's role within one organization. The unique
/// constraint on (userId, organizationId) is what makes "one membership per
/// user per org" a database guarantee rather than an application convention.
model Membership {
  id             String   @id @default(uuid(7))
  userId         String
  organizationId String
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTasks Task[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

/// A file uploaded to S3 (or MinIO in dev) and attached to a task. The row
/// is written only after the object is confirmed to exist via `headObject`
/// — the client uploads directly to the bucket via a presigned POST, so
/// this table is the record that an upload actually landed, not the upload
/// itself. `size` and `contentType` are read back from the bucket, not
/// trusted from the client's presign request. See docs/adr/0018.
model Attachment {
  id             String   @id @default(uuid(7))
  organizationId String
  taskId         String
  /// The S3 object key, generated server-side at presign time, e.g.
  /// orgs/{organizationId}/tasks/{taskId}/{uuid}-{fileName}.
  key            String   @unique
  fileName       String
  contentType    String
  size           Int
  uploadedById   String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([taskId, organizationId])
  @@map("attachments")
}
